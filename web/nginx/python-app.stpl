#=========================================================================#
# Python Application Proxy Template for HestiaCP - FastAPI Optimized      #
#=========================================================================#

server {
    listen %ip%:%proxy_port%;
    server_name %domain_idn%;
    return 301 https://%domain_idn%$request_uri;
}

server {
    listen %ip%:%proxy_ssl_port% http2 ssl;
    server_name %domain_idn%;
    
    ssl_certificate %ssl_pem%;
    ssl_certificate_key %ssl_key%;
    
    # SSL optimizations
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;
    
    # Modern cipher suites
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    
    error_log /var/log/%web_system%/domains/%domain%.error.log error;
    access_log /var/log/%web_system%/domains/%domain%.access.log combined;
    
    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types 
        text/plain 
        text/xml 
        text/css 
        text/javascript
        application/xml 
        application/json 
        application/javascript 
        application/x-javascript 
        image/svg+xml;
    gzip_disable "msie6";
    
    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # API location
    location / {
        # FastAPI running on port 8000 (adjust if needed)
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        
        # WebSocket support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # Standard proxy headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        
        # Disable caching for API
        proxy_cache_bypass $http_upgrade;
        proxy_no_cache $http_upgrade;
        
        # Timeouts
        proxy_connect_timeout 75s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
        
        # Buffering
        proxy_buffering off;
        proxy_redirect off;
        
        # Upload limits
        client_max_body_size 20M;
    }
    
    # Static files (if served by FastAPI, proxy them)
    location /static/ {
        alias %home%/%user%/web/%domain%/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }
    
    # Media files (uploads)
    location /media/ {
        alias %home%/%user%/web/%domain%/media/;
        expires 7d;
        add_header Cache-Control "public";
        access_log off;
    }
    
    # Error pages
    location /error/ {
        alias %home%/%user%/web/%domain%/document_errors/;
    }
    
    # Health check endpoint (no logging)
    location /health {
        proxy_pass http://127.0.0.1:8000/health;
        access_log off;
    }
    
    # Deny access to hidden files and version control
    location ~ /\.(?!well-known).* {
        deny all;
        return 404;
    }
    
    location ~ /\.(ht|git|svn|hg|bzr) {
        deny all;
        return 404;
    }
    
    # Include custom configs
    include %home%/%user%/conf/web/s%proxy_system%.%domain%.conf*;
}
